# Backend database settings
POSTGRES_DB=lifeforest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lifeforest123

# Spring Boot JWT secret
JWT_SECRET=lifeforest-dev-jwt-secret-key-32chars

# Docker Hub images for deployment
BACKEND_IMAGE=tiffanyphelipa/lifeforest-backend:latest

# Expo app backend URL for phone/emulator builds
# Leave empty for local Expo Go development; the app will auto-detect the LAN host.
EXPO_PUBLIC_API_URL=
